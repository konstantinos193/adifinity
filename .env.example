# Email Configuration (for contact form)
# Required for the contact form to send emails via Nodemailer
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Note: For Gmail, use an App Password instead of your regular password:
# 1. Go to Google Account > Security
# 2. Enable 2-Step Verification
# 3. Generate App Password for "Mail"
# 4. Use that 16-character password here

# Optional: EmailJS Configuration (alternative to Nodemailer)
# If using EmailJS instead of Nodemailer, set these:
# EMAILJS_SERVICE_ID=your_service_id
# EMAILJS_TEMPLATE_ID=your_template_id
# EMAILJS_PUBLIC_KEY=your_public_key

# Optional: Resend Configuration (alternative to Nodemailer)
# If using Resend instead of Nodemailer, set this:
# RESEND_API_KEY=re_your_api_key_here
